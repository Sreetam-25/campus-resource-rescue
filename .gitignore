# ==============================================================================
# Campus Resource Rescue — Root .gitignore
# ==============================================================================

# Node.js dependencies
node_modules/
.pnp
.pnp.js

# Build outputs & packaging artifacts
dist/
dist-ssr/
build/
*.zip

# AWS SAM build & deployment artifacts
.aws-sam/
samconfig.toml.bak

# Environment files & local overrides
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.env

# Exception: allow sanitized example configuration files
!.env.example
!*/.env.example
!.env.production.example
!*/.env.production.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.vite/
*.tsbuildinfo

# Sensitive credentials & keys
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
*.der
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
client_secrets*.json

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
