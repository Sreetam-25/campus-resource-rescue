# Campus Resource Rescue — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to frontend/.env.local for local frontend development.
# Obtain values from AWS SAM deployment outputs: sam deploy (in backend/)
# NEVER commit .env.local, .env.production, or files with actual secrets to git.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API Gateway invoke URL
# Format: https://{apiId}.execute-api.ap-southeast-2.amazonaws.com/v1
VITE_API_BASE_URL=https://REPLACE_WITH_API_ID.execute-api.ap-southeast-2.amazonaws.com/v1

# AWS Cognito Region
VITE_COGNITO_REGION=ap-southeast-2

# AWS Cognito User Pool ID
# Format: ap-southeast-2_XXXXXXXXX
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_REPLACE_WITH_USER_POOL_ID

# AWS Cognito App Client ID (Public SPA Client — no secret)
VITE_COGNITO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
