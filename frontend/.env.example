# Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values from SAM deployment output.
# NEVER commit .env.local to git.
#
# Obtain values after running: sam deploy (in backend/)
# The SAM stack Outputs section prints all required values.
# ─────────────────────────────────────────────────────────────────────────────

# API Gateway invoke URL (from SAM output: ApiBaseUrl)
# Format: https://{apiId}.execute-api.ap-southeast-2.amazonaws.com/v1
VITE_API_BASE_URL=https://REPLACE_WITH_API_ID.execute-api.ap-southeast-2.amazonaws.com/v1

# Cognito region (from SAM output: CognitoRegion)
VITE_COGNITO_REGION=ap-southeast-2

# Cognito User Pool ID (from SAM output: UserPoolId)
# Format: ap-southeast-2_XXXXXXXXX
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_REPLACE_WITH_POOL_ID

# Cognito App Client ID — no secret (from SAM output: UserPoolClientId)
VITE_COGNITO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
